# Pokémon Mystery Dungeon: Red Rescue Team - host / PS Vita port build.
#
#   make -f Makefile.port TARGET=host      32-bit Linux headless test build
#   make -f Makefile.port TARGET=armhost   ARMv7 headless build (qemu-arm), linked like the Vita
#   make -f Makefile.port TARGET=vita vpk  PS Vita build (needs $VITASDK)
#
# The build needs no ROM: all game data (graphics, maps, text, sound) is read
# from the user's ROM when the game starts (see tools/port/gen_data.py).

TARGET ?= host
BUILD := build/port-$(TARGET)
GEN := build/port-gen

PYTHON ?= python3
ARM_AS ?= arm-none-eabi-as
ARM_OBJDUMP ?= arm-none-eabi-objdump
PREPROC := tools/preproc/preproc

ifeq ($(TARGET),host)
CC := gcc
ARCHFLAGS := -m32 -fno-pie -no-pie -malign-data=abi
OPT ?= -O2 -g
LDLIBS := -lm -rdynamic -pthread
PLATFORM_SRC := $(wildcard platform/host/*.c)
OUT := $(BUILD)/pmd_host
else ifeq ($(TARGET),armhost)
CC := arm-linux-gnueabihf-gcc
ARCHFLAGS := -march=armv7-a -mtune=cortex-a9 -mfpu=neon -mfloat-abi=hard -mthumb
OPT ?= -O2 -g
LDLIBS := -lm -pthread -static -Wl,-Ttext-segment=0x81000000
PLATFORM_SRC := $(wildcard platform/host/*.c)
OUT := $(BUILD)/pmd_armhost
else ifeq ($(TARGET),vita)
VITASDK ?= /usr/local/vitasdk
CC := $(VITASDK)/bin/arm-vita-eabi-gcc
ARCHFLAGS := -march=armv7-a -mtune=cortex-a9 -mfpu=neon -mfloat-abi=hard -mthumb
OPT ?= -O2 -g -ffunction-sections -fdata-sections
LDLIBS := -Wl,-q -Wl,--gc-sections -T platform/vita/vita.ld -lvita2d -lSceDisplay_stub -lSceCtrl_stub -lSceTouch_stub -lSceAudio_stub \
          -lScePower_stub -lSceAppUtil_stub -lSceAppMgr_stub -lSceSysmodule_stub \
          -lSceCommonDialog_stub -lSceGxm_stub -lScePgf_stub -lpthread -lm
PLATFORM_SRC := $(wildcard platform/vita/source/*.c)
OUT := $(BUILD)/pmd_vita.elf
EXTRA_CFLAGS := -Wno-error=implicit-function-declaration -Wno-error=implicit-int \
                -Wno-error=incompatible-pointer-types -Wno-error=int-conversion -Wno-error=return-mismatch
endif

VERSION := $(shell cat platform/vita/VERSION)

# Helper threads of the renderer (0 = render on the main thread only).
RENDER_WORKERS ?= 2
ifneq ($(RENDER_WORKERS),0)
WORKER_DEF := -DMODE1_PTHREAD_WORKERS=$(RENDER_WORKERS)
endif

CPPFLAGS := -DPORT -DMODERN=1 -DNDEBUG -DNONMATCHING $(WORKER_DEF) -DMODE1_GBA_WIDTH=424 -DMODE1_GBA_HEIGHT=240 -DMODE1_GBA_BG_CLIP_X=1024 \
            -DPMD_PORT_VERSION=\"$(VERSION)\" -iquote include -I . -I port/ppu/include
CFLAGS := $(ARCHFLAGS) $(OPT) -std=gnu11 -fno-strict-aliasing -fwrapv -fno-common -fno-toplevel-reorder -w $(EXTRA_CFLAGS)

# Game sources: everything except the GBA-only pieces replaced by port/.
GAME_SRC := $(filter-out src/agb_flash.c src/agb_flash_1m.c src/agb_flash_le.c src/agb_flash_mx.c src/libisagbprn.c, \
              $(shell find src -name '*.c' -not -name '*.inc.c' | sort))
# data/unk_9D02950.s is 1.4 MiB of unused data (data/unknown_unused): left out.
DATA_SRC := $(filter-out data/unk_9D02950.s,$(sort $(wildcard data/*.s) $(wildcard sound/songs/*.s)))
PORT_SRC := $(wildcard port/*.c) port/ppu/src/mode1.c port/ppu/src/virtuappu.c

GAME_OBJ := $(patsubst %.c,$(BUILD)/%.o,$(GAME_SRC))
PORT_OBJ := $(patsubst %.c,$(BUILD)/%.o,$(PORT_SRC) $(PLATFORM_SRC))
GEN_OBJ := $(BUILD)/gen/m4a_asm.o $(BUILD)/gen/ground_map_asm.o $(BUILD)/gen/data_blobs.o $(BUILD)/gen/data_relocs.o $(BUILD)/gen/assets_list.o

all: $(OUT)

$(OUT): $(GAME_OBJ) $(PORT_OBJ) $(GEN_OBJ)
	$(CC) $(ARCHFLAGS) -o $@ $^ $(LDLIBS)

# Game sources: C preprocessor, the port's asset step (INCBIN -> run-time
# loading), then the decomp's text preprocessor, then the compiler.
# The converted graphics the sources INCBIN (sizes/hashes only) must exist.
$(GEN)/gfx.stamp: tools/port/make_graphics.sh
	@mkdir -p $(GEN)
	tools/port/make_graphics.sh
	@touch $@

$(BUILD)/src/%.o: src/%.c tools/port/pp_assets.py | $(GEN)/gfx.stamp
	@mkdir -p $(dir $@)
	@$(CC) -E $(CPPFLAGS) $(ARCHFLAGS) -std=gnu11 $< -o $(BUILD)/src/$*.i
	@$(PYTHON) tools/port/pp_assets.py $(BUILD)/src/$*.i $(BUILD)/src/$*.pp.i PortAssets_$(subst /,_,$(subst .,_,$*))
	@$(PREPROC) $(BUILD)/src/$*.pp.i charmap.txt > $(BUILD)/src/$*.pp.c
	$(CC) $(CFLAGS) -c $(BUILD)/src/$*.pp.c -o $@

# Calls the asset registration of every game source file.
$(BUILD)/gen/assets_list.c: Makefile.port
	@mkdir -p $(dir $@)
	@( echo '/* Generated by Makefile.port */'; \
	   for f in $(patsubst src/%.c,%,$(GAME_SRC)); do echo "void PortAssets_$$(echo $$f | tr '/.' '__')(void);"; done; \
	   echo 'void PortAssets_RegisterAll(void)'; echo '{'; \
	   for f in $(patsubst src/%.c,%,$(GAME_SRC)); do echo "    PortAssets_$$(echo $$f | tr '/.' '__')();"; done; \
	   echo '}' ) > $@
$(BUILD)/gen/assets_list.o: $(BUILD)/gen/assets_list.c
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# The software renderer is the hot path: optimised harder.
$(BUILD)/port/ppu/%.o: port/ppu/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -O3 -c $< -o $@

# Assembler data files (data/*.s, songs) -> empty arrays + relocations.
# (a stamp file: with -j the recipe of a multi-target rule would run twice)
$(GEN)/data.stamp: tools/port/gen_data.py tools/port/keysel.py $(DATA_SRC)
	$(PYTHON) tools/port/gen_data.py --out $(GEN) --as $(ARM_AS) $(DATA_SRC)
	@touch $@
$(GEN)/data_blobs.s $(GEN)/data_relocs.c: $(GEN)/data.stamp
	@test -f $@
$(BUILD)/gen/data_blobs.o: $(GEN)/data_blobs.s
	@mkdir -p $(dir $@)
	$(CC) $(ARCHFLAGS) -c $< -o $@
$(BUILD)/gen/data_relocs.o: $(GEN)/data_relocs.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# The hand-written sound engine core (src/m4a_1.s, src/arm_funcs.s) and the
# ground-map routine of src/ground_map.c, translated to C.
$(GEN)/asm.stamp: src/m4a_1.s src/arm_funcs.s src/ground_map.c tools/port/asm2c.py tools/port/gen_m4a.sh tools/port/extract_naked.py
	sh tools/port/gen_m4a.sh
	@touch $@
$(GEN)/m4a_asm.c $(GEN)/ground_map_asm.c: $(GEN)/asm.stamp
	@test -f $@
$(BUILD)/gen/m4a_asm.o: $(GEN)/m4a_asm.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
$(BUILD)/gen/ground_map_asm.o: $(GEN)/ground_map_asm.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# ---- PS Vita package ----
TITLE_ID := PMDR00001
TITLE := Mystery Dungeon Red
VPK := $(BUILD)/MysteryDungeonRed_Vita_$(VERSION).vpk
SCE := platform/vita/sce_sys
# Optional personal LiveArea artwork in platform/vita/sce_sys_local/ (git-ignored).
ART = $(if $(wildcard platform/vita/sce_sys_local/$(1)),platform/vita/sce_sys_local/$(1),$(SCE)/$(1))

vpk: $(VPK)

$(VPK): $(OUT) $(call ART,icon0.png) $(call ART,livearea/contents/bg.png) $(call ART,livearea/contents/startup.png) $(SCE)/livearea/contents/template.xml platform/vita/VERSION platform/vita/assets/bezel.png
	$(VITASDK)/bin/vita-elf-create $(OUT) $(BUILD)/pmd.velf
	$(VITASDK)/bin/vita-make-fself -s -c $(BUILD)/pmd.velf $(BUILD)/eboot.bin
	$(VITASDK)/bin/vita-mksfoex -s TITLE_ID=$(TITLE_ID) -s APP_VER=01.00 -d ATTRIBUTE2=12 "$(TITLE) $(VERSION)" $(BUILD)/param.sfo
	mkdir -p $(BUILD)/livearea
	$(PYTHON) platform/vita/tools/stamp_version.py $(call ART,livearea/contents/bg.png) $(BUILD)/livearea/bg.png $(VERSION) br
	$(PYTHON) platform/vita/tools/stamp_version.py $(call ART,livearea/contents/startup.png) $(BUILD)/livearea/startup.png $(VERSION) br
	mkdir -p $(BUILD)/assets
	$(PYTHON) platform/vita/tools/png2raw.py $(call ART,livearea/contents/bg.png) $(BUILD)/assets/bg.raw 480x272
	$(PYTHON) platform/vita/tools/png2raw.py platform/vita/assets/bezel.png $(BUILD)/assets/bezel.raw
	$(VITASDK)/bin/vita-pack-vpk -s $(BUILD)/param.sfo -b $(BUILD)/eboot.bin \
	    -a $(call ART,icon0.png)=sce_sys/icon0.png \
	    -a $(BUILD)/livearea/bg.png=sce_sys/livearea/contents/bg.png \
	    -a $(BUILD)/livearea/startup.png=sce_sys/livearea/contents/startup.png \
	    -a $(SCE)/livearea/contents/template.xml=sce_sys/livearea/contents/template.xml \
	    -a $(BUILD)/assets/bg.raw=assets/bg.raw \
	    -a $(BUILD)/assets/bezel.raw=assets/bezel.raw \
	    $@
	cp $(OUT) $(BUILD)/pmd_vita-$(VERSION).elf

clean:
	rm -rf $(BUILD)

distclean: clean
	rm -rf $(GEN)

.PHONY: all clean distclean vpk
